{
  "name": "unhinged-students",
  "version": "1.0.0",
  "description": "A game project.",
  "main": "dist/server/server/index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "start": "node dist/server/server/index.js",
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ server/ test/ shared/",
    "lint:fix": "eslint src/ server/ test/ shared/ --fix",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"server/**/*.ts\" \"test/**/*.ts\" \"shared/**/*.ts\"",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run build:server"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eiaserinnys/Unhinged-Students.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/eiaserinnys/Unhinged-Students/issues"
  },
  "homepage": "https://github.com/eiaserinnys/Unhinged-Students#readme",
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.6",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.2.0",
    "@playwright/test": "^1.58.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.5",
    "@typescript-eslint/parser": "^8.56.1",
    "babel-jest": "^30.2.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1"
  }
}
